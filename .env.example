# ==========================================
# MANIK Smart Hydroponic - Environment Config
# ==========================================

# Cloudflare Worker Edge Gateway
VITE_API_BASE_URL=https://enzoponik-worker.your-subdomain.workers.dev

# Google Gemini AI API Key (Optional)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (Optional)
VITE_OPENWEATHER_API_KEY=your_openweather_key_here

# HiveMQ / MQTT Broker WebSocket
VITE_MQTT_BROKER_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC_TEMP=manik/esp32/temp_secret99
VITE_MQTT_TOPIC_HUM=manik/esp32/hum_secret99

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

